% =====================================================================
%  atrpg.sty — Legend of the Technomancers RPG rulebook style
%  (The "atr" prefix predates the retitle from "Across the Realms";
%   it is internal-only and kept to avoid churn across ~83 call sites.)
%  Genre-neutral, clean design. Engine: XeTeX (tectonic) / LuaLaTeX.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{atrpg}[2026/09/18 Legend of the Technomancers rulebook style]

% ---- Fonts ----------------------------------------------------------
\RequirePackage{fontspec}
% Body: MPlantin — Plantin-based oldstyle serif; warm, humanist, indie-RPG feel.
\setmainfont{MPlantin}[
  Path        = /home/keenan/.fonts/,
  Extension   = .ttf,
  UprightFont = mplantin,
  BoldFont    = mplanti1,
  ItalicFont  = mplantinit,
  BoldItalicFont = mplantinit]
% Display/heading face: Beleren Bold — the game fantasy/sci-fi display face.
% Caps-only; every weight renders as bold, so \bfseries is a no-op here.
% Ligatures=TeX so `---' and ``quotes'' in headings render as real em-dashes
% and curly quotes rather than literal hyphens and backticks.
\newfontfamily\hdfont{beleren-bold_P1.01}[
  Path        = /home/keenan/.fonts/,
  Extension   = .ttf,
  Ligatures   = TeX,
  UprightFont = *,
  BoldFont    = *,
  ItalicFont  = *,
  BoldItalicFont = *]

% ---- Colour palette -------------------------------------------------
% To change any colour: edit the hex value here. Every chapter that uses
% that colour automatically picks up the change.
\RequirePackage{xcolor}

% Global chrome
\definecolor{atrInk}{HTML}{1A1A2E}      % deep navy-black
\definecolor{atrPaper}{HTML}{EFECE5}    % neutral off-white (page background)
\definecolor{atrAccent}{HTML}{2B5F75}   % default teal (non-column chapters)
\definecolor{atrAccent2}{HTML}{B56A2E}  % warm copper/amber — secondary
\definecolor{atrRule}{HTML}{A8A49C}     % cool neutral grey for rules/borders
\definecolor{atrBoxbg}{HTML}{E3DFD7}    % neutral parchment for box fills

% Four-column chapter accents — one per Building-a-Traveller chapter.
% Change the hex here to re-theme that chapter throughout.
\definecolor{columnBody}{HTML}{8B2831}  % ruby red   — physical form
\definecolor{columnStuff}{HTML}{5E2A84} % deep violet — possessions
\definecolor{columnSkills}{HTML}{2A6438}% forest green — learned craft
\definecolor{columnMagic}{HTML}{1A4E8C} % royal blue  — arcane

% Genre realm accents — one per The-Realms chapter.
\definecolor{realmFantasy}{HTML}{245C3B}% deep emerald
\definecolor{realmCyber}{HTML}{C81D77}  % hot magenta
\definecolor{realmSpace}{HTML}{1E5A7A}  % steel blue

% Per-chapter override hook: add \renewcommand{\realmaccent}{colorName}
% at the top of any chapter file to theme that chapter.
\newcommand{\realmaccent}{atrAccent}

% ---- Page geometry --------------------------------------------------
% driver=xetex is required so geometry emits \special{papersize=…} and
% xdvipdfmx uses A4 rather than its US-Letter default.
\RequirePackage[driver=xetex, a4paper,
  inner=18mm, outer=14mm, top=24mm, bottom=26mm,
  headsep=8mm, footskip=12mm]{geometry}
\RequirePackage[document]{ragged2e}  % gentle justification helper
\setlength{\columnsep}{7mm}          % gutter between the two columns
\setlength{\columnseprule}{0pt}      % set >0pt for a visible column rule

% ---- Paragraph spacing ------------------------------------------------
% Visible gap between paragraphs instead of a first-line indent, for
% readability in a narrow two-column reference layout. Fixed length (no
% plus/minus stretch) deliberately: \flushbottom's page-filling stretch
% comes from \baselineskip already, and adding elastic \parskip glue on
% top risks compounding the documented \textbf leading defect near the
% end of this file. Keep it inert.
\setlength{\parskip}{6pt}
\setlength{\parindent}{0pt}

% ---- Core structural packages --------------------------------------
\RequirePackage{microtype}
\RequirePackage{graphicx}
\graphicspath{{art/}}
% Centered chapter/spot illustration (transparent PNG cut-out).
% \chapterart[width]{file}
\newcommand{\chapterart}[2][0.68\linewidth]{%
  \par\smallskip\begin{center}\includegraphics[width=#1]{#2}\end{center}\par\smallskip}
% Bold full-width (both columns) banner — floats to a page top/bottom.
% Height-capped so a landscape cut-out reads as a ~half-page statement.
% \artbanner[placement]{file}
\newcommand{\artbanner}[2][tb]{%
  \begin{figure*}[#1]\centering
  \includegraphics[width=\textwidth,height=0.42\textheight,keepaspectratio]{#2}
  \end{figure*}}
% Inline (non-floating) column-width image — placed exactly where called.
% \artinline{file}
\newcommand{\artinline}[1]{%
  \par\medskip\noindent
  \includegraphics[width=\columnwidth,keepaspectratio]{#1}%
  \par\medskip}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
% Left-aligned auto-width column that wraps to fill the measure.
\newcolumntype{Y}{>{\RaggedRight\arraybackslash}X}
% Full-width-in-twocolumn insert that renders exactly where it appears in
% the source (unlike table*/figure*, which are floats and get deferred to
% the NEXT page when placed right after \chapter --- LaTeX will not let a
% [t] float claim the top of a page that a sectioning command already
% opened, no matter how little content is on that page otherwise).
\RequirePackage{cuted}
\RequirePackage{colortbl}
\RequirePackage{lettrine}
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{lipsum}   % placeholder prose — replace as chapters are written
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage[hidelinks]{hyperref}
% pdfcomment must come after hyperref; dvipdfmx is the correct driver for XeLaTeX/tectonic.
\RequirePackage[dvipdfmx]{pdfcomment}

% ---- Headings -------------------------------------------------------
\titleformat{\chapter}[display]
  {\hdfont\bfseries\color{\realmaccent}}
  {\normalfont\hdfont\large\color{atrRule}CHAPTER \thechapter}
  {6pt}{\Huge\MakeUppercase}
  [{\color{atrRule}\titlerule[1pt]}]
\titlespacing*{\chapter}{0pt}{4pt}{22pt}

\titleformat{\section}
  {\hdfont\Large\bfseries\color{\realmaccent}}{}{0pt}{}
\titleformat{\subsection}
  {\hdfont\large\bfseries\color{atrInk}}{}{0pt}{}
\titlespacing*{\section}{0pt}{14pt}{4pt}
\titlespacing*{\subsection}{0pt}{10pt}{2pt}

% ---- Running headers / footers -------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[LE]{\hdfont\small\color{atrRule}\thepage\quad LEGEND OF THE TECHNOMANCERS}
\fancyhead[RO]{\hdfont\small\color{atrRule}\leftmark\quad\thepage}
\renewcommand{\chaptermark}[1]{\markboth{\MakeUppercase{#1}}{}}

% ---- Rating pips (the 1–4 scale) -----------------------------------
% \rating{n}  → four pips, first n filled with the current realm accent.
% $\vcenter{\hbox{...}}$ centres the pip row on the math axis (≈ mid-cap-height),
% keeping dots visually inline regardless of body font metrics.
\newcommand{\rating}[1]{%
  \begingroup
  $\vcenter{\hbox{%
    \begin{tikzpicture}
      \foreach \i in {1,...,4}{%
        \ifnum\i>#1
          \node[circle,draw=atrRule,line width=0.4pt,minimum size=6pt,inner sep=0] at (\i*8pt,0){};
        \else
          \node[circle,fill=\realmaccent,minimum size=6pt,inner sep=0] at (\i*8pt,0){};
        \fi}
    \end{tikzpicture}}}$%
  \endgroup}

% ---- Iconography ----------------------------------------------------
% Small glyphs for the three Stats and for the four places a tag can come
% from. Each is drawn on a 10x10 canvas scaled to \atrIconH, so it stays in
% proportion at any size and inherits the surrounding text colour.
\usetikzlibrary{shapes.misc}
\newlength{\atrIconH}
\setlength{\atrIconH}{7.4pt}

\newcommand{\atr@icon@body}{%    barbell — physical power
  \fill (0.3,2.5) rectangle (2.5,7.5);
  \fill (7.5,2.5) rectangle (9.7,7.5);
  \fill (2.5,4.2) rectangle (7.5,5.8);}
\newcommand{\atr@icon@mind}{%    lightbulb — thought
  % The screw base is three bars with real gaps rather than grooves knocked
  % out in a background colour, so the icon works on paper, on the box tint,
  % and reversed out of a filled tag alike.
  \fill (5,6.7) circle (2.6);
  \fill (3.7,3.45) rectangle (6.3,4.35);
  \fill (3.7,2.15) rectangle (6.3,3.05);
  \fill (4.2,1.1)  rectangle (5.8,1.75);}
\newcommand{\atr@icon@face}{%    head and shoulders — dealing with people
  \fill (5,7.4) circle (2.0);
  \fill (1.3,0.8) .. controls (1.3,4.1) and (8.7,4.1) .. (8.7,0.8) -- cycle;}
\newcommand{\atr@icon@magic}{%   four-point sparkle
  \fill (5,9.7) .. controls (5.5,5.5) and (5.5,5.5) .. (9.7,5)
        .. controls (5.5,4.5) and (5.5,4.5) .. (5,0.3)
        .. controls (4.5,4.5) and (4.5,4.5) .. (0.3,5)
        .. controls (4.5,5.5) and (4.5,5.5) .. cycle;}
\newcommand{\atr@icon@skill}{%   chevron — training
  \fill (0.8,2.2) -- (5,6.4) -- (9.2,2.2) -- (9.2,4.6)
        -- (5,8.8) -- (0.8,4.6) -- cycle;}
\newcommand{\atr@icon@item}{%    satchel — something you carry
  \draw[line width=0.9] (3.3,6.3) .. controls (3.3,8.9) and (6.7,8.9) .. (6.7,6.3);
  \fill (1.0,1.3) rectangle (9.0,6.6);}

% \atricon{body|mind|face|magic|skill|item}
\newcommand{\atricon}[1]{%
  \raisebox{-0.08\atrIconH}{%
    \begin{tikzpicture}[x=0.1\atrIconH, y=0.1\atrIconH, line width=0.09\atrIconH]
      \csname atr@icon@#1\endcsname
    \end{tikzpicture}}}

% ---- Stat plates ----------------------------------------------------
% \statplate{body}{3} → icon + number in a rectangle. The rectangle is the
% visual signal "this is a rolled Stat", as opposed to an oval tag.
% Centred with $\vcenter{\hbox{...}}$ rather than TikZ's baseline= option:
% the icon nests a tikzpicture inside the node text, and baseline=(P.base)
% then fails with "No shape named P is known".
\newcommand{\statplate}[2]{%
  $\vcenter{\hbox{%
    \begin{tikzpicture}
      \node[draw=\realmaccent, line width=0.7pt, fill=atrBoxbg,
            inner xsep=3.4pt, inner ysep=2.6pt, outer sep=0pt]
        {\color{\realmaccent}\atricon{#1}\hspace{2.6pt}\textbf{#2}};
    \end{tikzpicture}}}$}

% \statplatenamed{body}{Body}{3} → same, with the name spelled out.
\newcommand{\statplatenamed}[3]{%
  $\vcenter{\hbox{%
    \begin{tikzpicture}
      \node[draw=\realmaccent, line width=0.7pt, fill=atrBoxbg,
            inner xsep=3.4pt, inner ysep=2.6pt, outer sep=0pt]
        {\color{\realmaccent}\atricon{#1}\hspace{2.6pt}%
         \textsc{#2}\hspace{2.6pt}\textbf{#3}};
    \end{tikzpicture}}}$}

% ---- Tag ovals ------------------------------------------------------
% \atrtag{magic}{Fire} → the tag word in an oval, with a provenance icon so
% you can see at a glance whether it came from magic, your body, a skill, or
% a piece of gear — i.e. whether it can be taken away from you.
\newcommand{\atrtag}[2]{%
  $\vcenter{\hbox{%
    \begin{tikzpicture}
      \node[rounded rectangle, draw=atrRule, line width=0.6pt, fill=atrBoxbg,
            inner xsep=5pt, inner ysep=2.4pt, outer sep=0pt]
        {{\color{atrAccent2}\atricon{#1}}\hspace{2.8pt}#2};
    \end{tikzpicture}}}$}

% Filled variant, for a tag that is live on the current roll.
\newcommand{\atrtagon}[2]{%
  $\vcenter{\hbox{%
    \begin{tikzpicture}
      \node[rounded rectangle, draw=\realmaccent, line width=0.6pt,
            fill=\realmaccent, text=white,
            inner xsep=5pt, inner ysep=2.4pt, outer sep=0pt]
        {\atricon{#1}\hspace{2.8pt}#2};
    \end{tikzpicture}}}$}

% ---- Boxes ----------------------------------------------------------
% Sidebar / designer's note.  (named notebox: \sidebar is taken by memoir)
\newtcolorbox{notebox}[1][]{%
  enhanced, breakable,
  colback=atrBoxbg, colframe=atrRule, boxrule=0.6pt, arc=2pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\hdfont\bfseries\color{\realmaccent},
  coltitle=\realmaccent, title={#1}}

% Read-aloud / in-fiction flavour text.
% colback=atrBoxbg (not atrPaper) so it's visible against the off-white page.
\newtcolorbox{readaloud}{%
  enhanced, breakable,
  colback=atrBoxbg, colframe=\realmaccent, boxrule=0pt,
  borderline west={2.2pt}{0pt}{\realmaccent},
  left=12pt, right=10pt, top=6pt, bottom=6pt,
  fontupper=\itshape}

% Rules example.
% The EXAMPLE tag straddles the top rule (anchor=east on frame.north east,
% with a paper-coloured fill that knocks the rule out behind it) rather than
% sitting inside the box. Anchored north east it overlapped the first line of
% body text, which is cripplingly visible in the narrow two-column measure.
\newtcolorbox{example}{%
  enhanced, breakable,
  colback=atrPaper, colframe=atrRule, boxrule=0.6pt, arc=1pt,
  left=8pt, right=8pt, top=5pt, bottom=5pt,
  before skip=7pt, after skip=7pt,
  overlay unbroken and first={%
    \node[anchor=east, fill=atrPaper, inner xsep=4pt, inner ysep=0.5pt,
          font=\hdfont\bfseries\scriptsize\color{atrRule}]
      at ([xshift=-9pt]frame.north east){EXAMPLE};}}

% Reader FAQ box --- a rules question phrased in the player's own voice,
% then answered straight. Same corner-tag technique as \example, distinct
% accent (atrAccent2, warm copper) so it reads as a different register:
% not a worked example, a straight-up "yeah, that's really how it works."
% Usage: \begin{question}{Question text?} Answer text. \end{question}
\newtcolorbox{question}[1]{%
  enhanced, breakable,
  colback=atrPaper, colframe=atrAccent2, boxrule=0.6pt, arc=1pt,
  left=8pt, right=8pt, top=5pt, bottom=5pt,
  before skip=7pt, after skip=7pt,
  overlay unbroken and first={%
    \node[anchor=east, fill=atrPaper, inner xsep=4pt, inner ysep=0.5pt,
          font=\hdfont\bfseries\scriptsize\color{atrAccent2}]
      at ([xshift=-9pt]frame.north east){Q\&A};},
  before upper={\bfseries\itshape\color{atrAccent2}``#1''\par\smallskip\normalfont\upshape}}

% Character-attribute stat block (the four columns).
\newtcolorbox{statblock}[1][Attribute Ranks]{%
  enhanced, breakable,
  colback=atrBoxbg, colframe=\realmaccent, boxrule=1pt, arc=2pt,
  left=10pt, right=10pt, top=8pt, bottom=8pt,
  fonttitle=\hdfont\bfseries\large\color{white},
  coltitle=white, colbacktitle=\realmaccent,
  title={#1}}

% ---- Item catalogue -------------------------------------------------
% Batch-restylable equipment entries.  Every purchasable thing in the
% book flows through these macros, so the whole catalogue re-themes from
% one place: change the definitions here and every list follows.
%
% Compact reference table:
%   \begin{gearlist}{Weapons}
%     \gear{Basic Weapon}{2}{A sword, a pistol --- a reliable killer.}
%     \gear{Special Weapon}{3}{...}
%   \end{gearlist}
%
% Rating in these macros is the Stuff rank required to own the item
% (2--4), shown as filled pips.
% NB: plain tabular (not tabularx) — a tabularx cannot be split across an
% environment's begin/end code (its body scanner never sees \end{tabularx}).
% Fixed p-column widths keep the whole thing inside a single column.
% NB 2: \leavevmode must lead every >{...} prefix. ragged2e is loaded with
% [document], which hooks \everyselectfont; a raw font switch such as
% \bfseries as the first thing in a p-cell fires that hook in vertical mode
% and drops the whole cell one line below its neighbours. (\textbf is safe
% — it supplies \leavevmode itself — but a bare \bfseries group is not.)
\newenvironment{gearlist}[1]{%
  \begin{statblock}[#1]%
  \begin{tabular}{@{}>{\leavevmode\bfseries\color{\realmaccent}\RaggedRight}p{0.26\linewidth} l >{\leavevmode\RaggedRight\arraybackslash}p{0.44\linewidth}@{}}}
{%
  \end{tabular}\end{statblock}}
\newcommand{\gear}[3]{#1 & \rating{#2} & #3\\[3pt]}

% Fuller, prose-length entry (name + required rank + a paragraph).
% Use for gear that deserves its own write-up.
%   \gearentry{Mount}{2}{A horse in one realm, a motorbike in the next...}
\newcommand{\gearentry}[3]{%
  \par\smallskip\noindent
  {\hdfont\bfseries\color{\realmaccent}#1}\hspace{1em}\rating{#2}%
  \par\nobreak\smallskip#3\par\smallskip}

% Genre translation hint — "in the sprawl, this is a hovercar."
% Kept as its own macro so translations can be restyled or indexed later.
\newcommand{\genretrans}[1]{\par\smallskip{\small\itshape\color{atrAccent2}Across the realms: #1}\par}

% Skill entry — name (as a skill-provenance tag), primary stat, description.
% A Skill is a boolean tag like any other: you know it or you don't.
%   \skill{Blades}{Agility}{Swords, knives, and any weapon that cuts.}
\newcommand{\skill}[3]{%
  \par\smallskip\noindent\hangindent=1em
  \atrtag{skill}{#1}%
  ~{\small\itshape(#2)} --- #3\par}

% Skill category label — Beleren at text size, accent colour, no box.
%   \skillcat{Conflict}
\newcommand{\skillcat}[1]{%
  \par\medskip\noindent
  {\hdfont\normalsize\bfseries\color{\realmaccent}#1}%
  \par\smallskip\nobreak}

% Reskin table — maps a generic catalogue line to this realm's version.
% Used in the genre chapters to translate Stuff/Body/etc. into local form.
%   \begin{reskin}{Stuff: Vehicles}
%     \reskinrow{Mount}{A warhorse, or a griffon for the bold.}
%   \end{reskin}
% Plain tabular, and \leavevmode-led prefixes (see both gearlist notes).
\newenvironment{reskin}[1]{%
  \begin{statblock}[#1]%
  \begin{tabular}{@{}>{\leavevmode\bfseries\color{\realmaccent}\RaggedRight}p{0.30\linewidth} >{\leavevmode\RaggedRight\arraybackslash}p{0.54\linewidth}@{}}}
{%
  \end{tabular}\end{statblock}}
\newcommand{\reskinrow}[2]{#1 & #2\\[4pt]}

% ---- Editorial TODO annotations ------------------------------------
% \todo{What needs doing} — inline checklist icon visible in PDF;
% hover or click the icon in Okular to see the note text.
\newcommand{\todo}[1]{%
  \raisebox{-2pt}{%
    $\vcenter{\hbox{%
      \begin{tikzpicture}[x=1pt, y=1pt, line width=0.4pt]
        \fill[yellow!70!orange!90] (0,0) rectangle (10,10);
        \draw[yellow!30!black, line width=0.35pt] (0,0) rectangle (10,10);
        \draw[white, line width=0.6pt] (2,7.5) -- (8,7.5);
        \draw[white, line width=0.6pt] (2,5.0) -- (8,5.0);
        \draw[white, line width=0.6pt] (2,2.5) -- (6,2.5);
      \end{tikzpicture}}}$}%
  \pdfcomment[color={1 0.85 0.1}, icon=Note, open=false, subject={TODO}]{#1}}

% ---- Small helpers --------------------------------------------------
\newcommand{\keyword}[1]{\textbf{\color{\realmaccent}#1}}
\newcommand{\dice}[1]{\textsf{#1}}
\setlist{leftmargin=1.4em, itemsep=2pt, topsep=3pt}

% ---- Page background -----------------------------------------------
% Applied at document start so it takes effect on all pages (the cover
% page art covers this completely; interior pages show the off-white).
\AtBeginDocument{\pagecolor{atrPaper}}

% ---- KNOWN DEFECT: uneven leading on \textbf lines ------------------
% Fourteen lines in the book sit ~6.9pt lower than their neighbours (20.45pt
% pitch against a normal 13.55pt). Every one is a line containing \textbf,
% which in practice means every line carrying a \keyword.
%
% Established so far, by A/B-ing the full book and counting line-pitch
% anomalies out of `pdftotext -bbox-layout`:
%   * \textbf is the trigger; the \color in \keyword is innocent (0 anomalies
%     with colour alone, 14 with bold alone).
%   * NOT microtype, NOT ragged2e's [document] option, NOT \flushbottom
%     (\raggedbottom changes nothing).
%   * NOT the fonts: MPlantin bold's vertical metrics are normal
%     (asc 761 / desc -238 per 1000 upm) and an isolated \vbox of the exact
%     offending paragraph is perfectly uniform — TeX's own box dump shows
%     \glue(\baselineskip) 3.84357 between every line.
%   So the extra space is introduced when the paragraph is contributed to
%   the page, not while the paragraph is being broken.
%
% \AtBeginDocument{\lineskiplimit=-\maxdimen} suppresses all 14, but it is
% NOT a usable fix: it also forces \baselineskip between table rows, which
% collapses every \rating-bearing row in every statblock and gearlist on top
% of the row above. Scoping it back out with etoolbox's \AtBeginEnvironment
% on tabular/tabularx/longtable did not restore them.
%
% Left unfixed deliberately: a 6.9pt wobble on 14 lines is a far smaller
% problem than collapsed tables, and the real cause is not yet identified.
%
% NB: this file ends with \endinput. Anything appended AFTER it is silently
% ignored — inject experiments above this line or they will appear to work
% and actually do nothing.

\endinput
